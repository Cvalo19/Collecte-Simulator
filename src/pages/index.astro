<script>
  const $ = <T extends Element>(selector: string, root: ParentNode = document) => root.querySelector<T>(selector);
  const $$ = <T extends Element>(selector: string, root: ParentNode = document) => Array.from(root.querySelectorAll<T>(selector));
  const idInput = $<HTMLInputElement>("#identification");
  const validateBtn = $<HTMLButtonElement>("#validateBtn");
  const statusText = $("#statusText");
  const resetBtn = $<HTMLButtonElement>("#resetBtn");
  const customerForm = $<HTMLFormElement>("#customerForm");
  const nextBtn = $<HTMLButtonElement>("#nextBtn");
  const menuToggle = $<HTMLButtonElement>("#menuToggle");
  const sidebar = $("#sidebar");

  
const addressTypeField = $("#addressTypeField");
const gisAddressField = $("#gisAddressField");
const urbanAddressFields = $("#urbanAddressFields");

function updateAddressType() {
  const selectedType = $<HTMLInputElement>(
    'input[name="addressType"]:checked'
  )?.value;

  const isRural = selectedType === "rural";

  // Cambiar el ancho del selector
if (addressTypeField) {
  addressTypeField.style.gridColumn = isRural ? "span 2" : "span 4";
}

  // Mostrar u ocultar los campos correspondientes
  if (gisAddressField) {
    gisAddressField.hidden = !isRural;
  }

  if (urbanAddressFields) {
    urbanAddressFields.hidden = isRural;
  }
}

// Escuchar los cambios entre Urbana y Rural
$$<HTMLInputElement>(
  'input[name="addressType"]'
).forEach((radio) => {
  radio.addEventListener("change", updateAddressType);
});

// Establecer la vista inicial
updateAddressType();


  const searchableSelects = $$<HTMLElement>("[data-searchable-select]");
  const normalize = (text: string) => text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();

  function filterSelect(root: HTMLElement) {
    const filter = $<HTMLInputElement>(".searchable-filter", root);
    const empty = $(".searchable-empty", root);
    if (!filter || !empty) return;
    const query = normalize(filter.value);
    let matches = 0;
    $$<HTMLButtonElement>(".searchable-option", root).forEach((option) => {
      option.hidden = !normalize(option.textContent ?? "").includes(query);
      if (!option.hidden) matches++;
    });
    empty.hidden = matches > 0;
  }

  function closeSelect(root: HTMLElement) {
    const menu = $(".searchable-menu", root);
    const trigger = $<HTMLButtonElement>(".searchable-trigger", root);
    if (menu) (menu as HTMLElement).hidden = true;
    trigger?.setAttribute("aria-expanded", "false");
  }

  function openSelect(root: HTMLElement) {
    const menu = $<HTMLDivElement>(".searchable-menu", root);
    const trigger = $<HTMLButtonElement>(".searchable-trigger", root);
    const filter = $<HTMLInputElement>(".searchable-filter", root);
    if (!menu || !trigger || !filter) return;
    menu.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
    filter.value = "";
    filterSelect(root);
    filter.focus();
  }

  searchableSelects.forEach((root) => {
    const trigger = $<HTMLButtonElement>(".searchable-trigger", root);
    const filter = $<HTMLInputElement>(".searchable-filter", root);
    const hiddenInput = $<HTMLInputElement>('input[type="hidden"]', root);
    const selected = $(".searchable-selected", root);
    trigger?.addEventListener("click", () => {
      const menu = $<HTMLDivElement>(".searchable-menu", root);
      if (menu?.hidden) openSelect(root); else closeSelect(root);
    });
    filter?.addEventListener("input", () => filterSelect(root));
    $<HTMLDivElement>(".searchable-options", root)?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement) || !target.matches(".searchable-option")) return;
      const value = target.dataset.value;
      if (!value || !hiddenInput || !selected) return;
      hiddenInput.value = value;
      selected.textContent = value;
      closeSelect(root);
      if (root.dataset.field === "department") updateCities(value);
    });
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    searchableSelects.forEach((root) => { if (!root.contains(event.target as Node)) closeSelect(root); });
  });

  const citiesByDepartment: Record<string, string[]> = {
    "Amazonas": ["Leticia"], "Antioquia": ["Medellín"], "Arauca": ["Arauca"], "Atlántico": ["Barranquilla"],
    "Bogotá D.C.": ["Bogotá D.C."], "Bolívar": ["Cartagena"], "Boyacá": ["Tunja"], "Caldas": ["Manizales"],
    "Caquetá": ["Florencia"], "Casanare": ["Yopal"], "Cauca": ["Popayán"], "Cesar": ["Valledupar"],
    "Chocó": ["Quibdó"], "Córdoba": ["Montería"], "Cundinamarca": ["Bogotá D.C."], "Guainía": ["Inírida"],
    "Guaviare": ["San José del Guaviare"], "Huila": ["Neiva"], "La Guajira": ["Riohacha"], "Magdalena": ["Santa Marta"],
    "Meta": ["Villavicencio"], "Nariño": ["Pasto"], "Norte de Santander": ["Cúcuta"], "Putumayo": ["Mocoa"],
    "Quindío": ["Armenia"], "Risaralda": ["Pereira"], "San Andrés y Providencia": ["San Andrés"], "Santander": ["Bucaramanga"],
    "Sucre": ["Sincelejo"], "Tolima": ["Ibagué"], "Valle del Cauca": ["Cali"], "Vaupés": ["Mitú"], "Vichada": ["Puerto Carreño"]
  };

  function updateCities(department: string) {
    const root = $('[data-field="city"]');
    if (!root) return;
    const hiddenInput = $<HTMLInputElement>('input[type="hidden"]', root);
    const selected = $(".searchable-selected", root);
    const optionsContainer = $(".searchable-options", root);
    if (hiddenInput) hiddenInput.value = "";
    if (selected) selected.textContent = "Ciudad*";
    if (!optionsContainer) return;
    optionsContainer.replaceChildren();
    (citiesByDepartment[department] ?? []).forEach((city) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "searchable-option";
      button.dataset.value = city;
      button.textContent = city;
      button.addEventListener("click", () => {
        if (hiddenInput) hiddenInput.value = city;
        if (selected) selected.textContent = city;
        closeSelect(root);
      });
      optionsContainer.append(button);
    });
  }

  idInput?.addEventListener("input", () => { idInput.value = idInput.value.replace(/\D/g, ""); });
  validateBtn?.addEventListener("click", () => {
    if (statusText) { statusText.textContent = "Pendiente de simulación"; statusText.classList.add("pending"); }
    if (validateBtn) validateBtn.textContent = "Validación pendiente";
  });

  
const validationModal = $("#validationModal");
const validationHeader = $("#validationHeader");
const validationResult = $("#validationResult");
const validationNext = $("#validationNext");
const validationMessage = $("#validationMessage");
const trafficLight = $("#trafficLight");
const trafficLightBulb = $("#trafficLightBulb");
const closeValidation = $("#closeValidation");
const acceptValidation = $("#acceptValidation");

const validationScenarios = {
  verde: {
    color: "#65bd00",
    result: "Resultado Validación Verde",
    next: "Continúa con el flujo normal de la venta.",
    message: "Procedemos a ingresar la solicitud en nuestro sistema.",
    bulb: "radial-gradient(circle at 35% 28%, #b6f5a0, #49d52b 55%, #1a9b20)"
  },
  amarillo: {
    color: "#c59a00",
    result: "Resultado Validación Amarillo",
    next: "Puedes continuar con el proceso. Registra el resultado en las observaciones.",
    message: "Continuaremos con el proceso y dejaremos registrada la observación correspondiente.",
    bulb: "radial-gradient(circle at 35% 28%, #fff5a8, #ffd629 55%, #c58b00)"
  },
  naranja: {
    color: "#e98225",
    result: "Resultado Validación Naranja",
    next: "Escenario educativo: verifica el procedimiento antes de continuar.",
    message: "Te informaremos el resultado de la revisión antes de continuar con la solicitud.",
    bulb: "radial-gradient(circle at 35% 28%, #ffd1a1, #ff8a24 55%, #bd4b00)"
  },
  rojo: {
    color: "#dc4141",
    result: "Resultado Validación Rojo",
    next: "No continúes con el flujo de venta en esta simulación.",
    message: "Por el momento no podemos continuar con la solicitud.",
    bulb: "radial-gradient(circle at 35% 28%, #ffaaaa, #f33d3d 55%, #a90000)"
  }
};

function getInputValue(selector) {
  return $<HTMLInputElement>(selector)?.value.trim() ?? "";
}

function openValidationModal() {
  const identification = idInput?.value.trim() ?? "";

  if (!identification || !/^\d+$/.test(identification)) {
    alert("Ingresa una cédula válida compuesta únicamente por números.");
    idInput?.focus();
    return;
  }

  // Ignorar ceros a la izquierda.
  const significantDigits = identification.replace(/^0+/, "");

  if (!significantDigits) {
    alert("La cédula no puede estar compuesta únicamente por ceros.");
    idInput?.focus();
    return;
  }

  const firstDigit = significantDigits[0];

  let scenarioKey;

  if (["1", "2", "3"].includes(firstDigit)) {
    scenarioKey = "verde";
  } else if (["4", "5", "6"].includes(firstDigit)) {
    scenarioKey = "amarillo";
  } else if (["7", "8"].includes(firstDigit)) {
    scenarioKey = "naranja";
  } else {
    scenarioKey = "rojo";
  }

  const scenario = validationScenarios[scenarioKey];

  // Obtener el nombre del cliente desde el formulario.
  const firstName = getInputValue(
    'input[placeholder="Primer nombre*"]'
  );
  const secondName = getInputValue(
    'input[placeholder="Segundo nombre"]'
  );
  const firstSurname = getInputValue(
    'input[placeholder="Primer Apellido *"]'
  );
  const secondSurname = getInputValue(
    'input[placeholder="Segundo Apellido"]'
  );

  const fullName = [
    firstName,
    secondName,
    firstSurname,
    secondSurname
  ].filter(Boolean).join(" ");

  validationResult.textContent = scenario.result;
  validationResult.style.color = scenario.color;

  validationNext.textContent = scenario.next;

  validationMessage.textContent = fullName
    ? `Señor/a ${fullName.toUpperCase()}. ${scenario.message}`
    : scenario.message;

  if (trafficLightBulb) {
    trafficLightBulb.style.background = scenario.bulb;
  }

  trafficLight?.setAttribute(
    "aria-label",
    `Semáforo de validación ${scenarioKey}`
  );

  // Diferenciar visualmente cada encabezado.
  if (validationHeader) {
    validationHeader.style.background =
      scenarioKey === "verde" ? "#4053b5" : scenario.color;
  }

  if (validationModal) {
    validationModal.hidden = false;
  }

  // Actualizar el estado de la simulación.
  if (statusText) {
    statusText.textContent =
      scenarioKey === "verde" ? "Validado (simulación)" :
      scenarioKey === "amarillo" ? "Validado con observación (simulación)" :
      scenarioKey === "naranja" ? "Revisión pendiente (simulación)" :
      "No continuar (simulación)";

    statusText.classList.toggle(
      "pending",
      scenarioKey === "amarillo" || scenarioKey === "naranja"
    );
  }
}

function closeValidationModal() {
  if (validationModal) {
    validationModal.hidden = true;
  }
}

validateBtn?.addEventListener("click", openValidationModal);
closeValidation?.addEventListener("click", closeValidationModal);
acceptValidation?.addEventListener("click", closeValidationModal);

validationModal?.addEventListener("click", (event) => {
  if (event.target === validationModal) {
    closeValidationModal();
  }
});

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && validationModal && !validationModal.hidden) {
    closeValidationModal();
  }
});


  const providerButtons = $$<HTMLButtonElement>(".provider-button");
  function selectProvider(provider: string) {
    providerButtons.forEach((button) => {
      const active = button.dataset.provider === provider;
      button.classList.toggle("active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    const providerName = $("#providerName");
    const providerValue = $<HTMLInputElement>("#providerValue");
    const message = $("#providerMessage");
    if (providerName) providerName.textContent = provider;
    if (providerValue) providerValue.value = provider;
    message?.classList.toggle("tigo-message", provider === "Tigo");
    message?.classList.toggle("coltel-message", provider === "Coltel B2C");
  }
  providerButtons.forEach((button) => button.addEventListener("click", () => { if (button.dataset.provider) selectProvider(button.dataset.provider); }));

  resetBtn?.addEventListener("click", () => {
    customerForm?.reset();
    if (statusText) { statusText.textContent = "Terminado"; statusText.classList.remove("pending"); }
    if (validateBtn) validateBtn.textContent = "Validar Cliente";
    searchableSelects.forEach((root) => {
      const input = $<HTMLInputElement>('input[type="hidden"]', root);
      const selected = $(".searchable-selected", root);
      if (input) input.value = "";
      if (selected) selected.textContent = root.dataset.placeholder ?? "Seleccionar";
      closeSelect(root);
    });
    const placeholders: Record<string, string> = { person: "Tipo de Persona *", idType: "Tipo *", domain: "Dominio", department: "Departamento*", city: "Ciudad*", regional: "Regional*", network: "Tipo red *", campaign: "Tipo Campaña*" };
    searchableSelects.forEach((root) => { const selected = $(".searchable-selected", root); const key = root.dataset.field ?? ""; if (selected && placeholders[key]) selected.textContent = placeholders[key]; });
    selectProvider("Tigo");
    updateCities("");
    updateAddressType();
  });
  nextBtn?.addEventListener("click", () => alert("Esta etapa se implementará después en el simulador de formación."));
  menuToggle?.addEventListener("click", () => sidebar?.classList.toggle("sidebar-hidden"));
</script>

  </body>
</html>