---
import "../styles/global.css";
import SearchableSelect from "../components/SearchableSelect.astro";
import InfoTooltip from "../components/InfoTooltip";

const addressRows = [
  { fields: [
    { name: "SEG#1 *", type: "select", options: ["Seleccionar", "Calle", "Carrera", "Avenida", "Diagonal", "Transversal"] },
    { name: "Numero *", type: "text" }, { name: "Letra", type: "text" }, { name: "BIS", type: "check" }
  ]},
  { fields: [
    { name: "Zona", type: "select", options: ["Seleccionar", "Norte", "Sur", "Este", "Oeste"] },
    { name: "Numero", type: "text" }, { name: "Letra", type: "text" }, { name: "BIS", type: "check" }
  ]},
  { fields: [
    { name: "Zona", type: "select", options: ["Seleccionar", "Interior", "Apartamento", "Local"] },
    { name: "Puerta", type: "text" }, { name: "Torre", type: "text" }, { name: "Bloque", type: "text" }
  ]},
  { fields: [{ name: "Tipo", type: "select", options: ["Seleccionar", "Casa", "Apartamento", "Local", "Oficina", "Otro"] }] }
];
const personOptions = ["Persona Natural", "Persona Jurídica"];
const idTypeOptions = ["CC", "CE", "NIT", "CV"];
const domainOptions = ["@gmail.com", "@hotmail.com", "@gmail.es", "@hotmail.es", "@"];
const departmentOptions = ["Amazonas", "Antioquia", "Arauca", "Atlántico", "Bogotá D.C.", "Bolívar", "Boyacá", "Caldas", "Caquetá", "Casanare", "Cauca", "Cesar", "Chocó", "Córdoba", "Cundinamarca", "Guainía", "Guaviare", "Huila", "La Guajira", "Magdalena", "Meta", "Nariño", "Norte de Santander", "Putumayo", "Quindío", "Risaralda", "San Andrés y Providencia", "Santander", "Sucre", "Tolima", "Valle del Cauca", "Vaupés", "Vichada"];
const regionalOptions = ["Bogotá", "Costa", "Andina", "Sur", "Oriente"];
const networkOptions = ["HFC", "REDCO", "GPON", "MOVIL"];
const campaignOptions = ["Base Propia", "Full tigo", "Migracion", "Portabilidad", "Pos a pos", "Series", "winback", "referidos", "remarketing", "Whatsapp", "Upselling full equipo", "Coltel - Movistar"];
const cityOptions: string[] = [];
