<!-- Modal de resultado de validación -->
<div
  class="validation-overlay"
  id="validationModal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="validationTitle"
>
  <section class="validation-modal">
    <header class="validation-header" id="validationHeader">
